{
  "name": "@cybrix/bot",
  "version": "0.1.0",
  "private": true,
  "description": "CYBRIX Telegram Management Bot — Cloudflare Worker thin client over the CYBRIX REST API (Prompt 6)",
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "webhook:set": "node tools/webhook.mjs set",
    "webhook:delete": "node tools/webhook.mjs delete"
  },
  "dependencies": {
    "@cybrix/shared-types": "*",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250914.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wrangler": "^3.90.0"
  }
}

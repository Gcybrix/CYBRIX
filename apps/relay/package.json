{
  "name": "@cybrix/relay",
  "version": "0.1.0",
  "private": true,
  "description": "CYBRIX Railway Relay — outbound-only network/data-plane agent over the CYBRIX REST API (Prompt 7). Zero runtime dependencies.",
  "main": "dist/apps/relay/src/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/relay/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "egress:check": "node scripts/verify-egress.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}

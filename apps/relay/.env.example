# CYBRIX Relay — environment template (Prompt 7 §22)
# Copy to `.env` (local) or set as Railway Variables/Secrets. NEVER commit real values.
# Raw relay token appears ONLY once in the Panel when issued/rotated (Prompt 4 §10.6).

# --- REQUIRED ---------------------------------------------------------------

# Relay identity created in the Panel (Prompt 7 §5). Fixed UUIDv4 from the Panel.
RELAY_ID=00000000-0000-4000-8000-000000000000

# Bearer token issued by POST /api/v1/relays/:id/token (shown exactly once).
RELAY_TOKEN=cbx_rl_REPLACE_ME_FROM_PANEL
# Alternative to RELAY_TOKEN (mount as secret file; enables SIGHUP hot reload):
# RELAY_TOKEN_FILE=/run/secrets/relay_token

# Base URL of YOUR CYBRIX Panel (SSOT). Outbound-only HTTPS.
CYBRIX_API_URL=https://your-panel.example.workers.dev

# --- OPTIONAL (defaults shown) ----------------------------------------------

# Local health endpoint (Railway healthcheck). Not a management API.
PORT=8080
HEALTH_BIND=0.0.0.0
# Runtime state directory (queue + cursors). Mount a Railway Volume to survive
# restarts; without a volume state is ephemeral (documented trade-off).
DATA_DIR=./data

# Loops (seconds)
HEARTBEAT_INTERVAL_S=60
SYNC_INTERVAL_S=30
USAGE_FLUSH_INTERVAL_S=60

# HTTP client (Prompt 7 §18: timeout, bounded retry, exp backoff + jitter)
HTTP_TIMEOUT_MS=10000
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_MS=1000
RETRY_MAX_BACKOFF_MS=60000

# Offline buffer caps (Prompt 7 §17; deterministic drop-oldest on overflow)
QUEUE_MAX_REPORTS=2000
QUEUE_MAX_BYTES=26214400

# Graceful shutdown flush budget (Prompt 7 §20)
SHUTDOWN_FLUSH_TIMEOUT_MS=20000

# debug | info | warn | error
LOG_LEVEL=info

# Set to 1 ONLY for local development to allow http:// API URL
# ALLOW_INSECURE_API=0
